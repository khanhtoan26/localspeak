{
  "name": "localspeak",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @localspeak/contracts build && concurrently \"pnpm --filter web dev\" \"pnpm --filter api start:dev\"",
    "dev:web": "pnpm --filter @localspeak/contracts build && pnpm --filter web dev",
    "dev:api": "pnpm --filter @localspeak/contracts build && pnpm --filter api start:dev",
    "dev:api:insecure-tls": "pnpm --filter @localspeak/contracts build && pnpm --filter api start:dev:insecure-tls",
    "check": "pnpm --filter @localspeak/contracts build && pnpm -r check",
    "test": "pnpm --filter @localspeak/contracts build && pnpm -r test",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
